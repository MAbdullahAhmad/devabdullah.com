# Copy to .env.local for local development; never commit real values.

# Email for the contact form and book-a-call (OC.18). Set ONE of these:
#
# A) SMTP, e.g. your Zoho Mail account (used first when all three are set).
#    Zoho: smtppro.zoho.com for domain (organisation) accounts, smtp.zoho.com
#    for personal ones (.eu / .in etc. for other data centres); port 465.
#    Use an app-specific password (Zoho → My Account → Security → App
#    Passwords). SMTP needs a Zoho plan with IMAP/SMTP access.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#
# B) The Resend API, from a domain verified in Resend.
RESEND_API_KEY=
#
# Recipient inbox. Defaults to profile.contact.email (hello@devabdullah.com).
CONTACT_TO=
# Sender. Defaults to "Abdullah Ahmad <hello@devabdullah.com>" (with SMTP,
# the SMTP_USER address).
CONTACT_FROM=
#
# Without A or B the forms don't send; they offer a filled-in email instead.

# Canonical origin for absolute URLs (SEO, OG, sitemap).
NEXT_PUBLIC_SITE_URL=https://devabdullah.com
# Set to true on the production deployment only to allow search indexing.
SITE_INDEXABLE=
